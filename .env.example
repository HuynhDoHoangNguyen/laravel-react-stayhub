# Shared local configuration for Laravel, Vite and Docker Compose.
# Copy to .env at repository root. Replace password placeholders before first Docker start.
# Existing Docker volumes keep their original credentials; editing this file does not rotate them.
COMPOSE_PROJECT_NAME=stayhub-dev
MYSQL_PORT=3307
MYSQL_DATABASE=stayhub
MYSQL_USER=stayhub
MYSQL_PASSWORD=replace_with_a_local_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_root_password

# Laravel (PHP running on the host)
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=${MYSQL_PORT}
DB_DATABASE=${MYSQL_DATABASE}
DB_USERNAME=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local SPA session settings; use localhost consistently for both applications.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
SESSION_SECURE_COOKIE=false

# Only VITE_* variables are public. Never give secrets this prefix.
# StayHub Frontend Environment Variables Example
VITE_BACKEND_URL=http://localhost:8000

# Enable UI development mocks for properties when backend catalog API is not yet available
# Set to 'true' to load mock boutique stays in DEV mode only. Never active in production builds.
VITE_ENABLE_PROPERTY_MOCKS=true

# Enable UI development mocks for bookings when backend booking API is not yet available (TV2)
# Set to 'true' to load mock customer bookings in DEV mode only. Never active in production builds.
VITE_ENABLE_BOOKING_MOCKS=true

# StayHub support chat. Keep GEMINI_API_KEY on the Laravel server.
GEMINI_API_KEY=
SUPPORT_CHAT_AI_ENABLED=false
# Allows chat questions to leave StayHub for the provider.
SUPPORT_CHAT_ALLOW_EXTERNAL_QUESTIONS=false
GEMINI_MODEL=gemini-3.5-flash-lite
SUPPORT_CHAT_TIMEOUT_MS=12000
SUPPORT_CHAT_MAX_OUTPUT_TOKENS=500
SUPPORT_CHAT_RATE_LIMIT_PER_MINUTE=10
SUPPORT_CHAT_MAX_CONCURRENT=2
VITE_ENABLE_GUEST_CHAT=true
SUPPORT_GUEST_CHAT_ENABLED=true
SUPPORT_GUEST_CHAT_ALLOW_PROVIDER=false

# StayHub Commission Remittance Bank Account
# When unset or empty, the system hides remittance payment instructions.
STAYHUB_BANK_NAME=
STAYHUB_BANK_ACCOUNT_NUMBER=
STAYHUB_BANK_ACCOUNT_HOLDER=
