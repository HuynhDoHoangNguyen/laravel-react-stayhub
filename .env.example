# Copy this file to .env at the repository root before starting Docker Compose.
# Replace both password placeholders with distinct local passwords.
# Laravel does not automatically read this root file; backend/.env is separate.
COMPOSE_PROJECT_NAME=stayhub-dev
MYSQL_PORT=3307
MYSQL_DATABASE=stayhub
MYSQL_USER=stayhub
MYSQL_PASSWORD=replace_with_a_local_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_root_password
