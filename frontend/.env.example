# StayHub Frontend Environment Variables Example
VITE_BACKEND_URL=http://localhost:8000

# Enable UI development mocks for properties when backend catalog API is not yet available
# Set to 'true' to load mock boutique stays in DEV mode only. Never active in production builds.
VITE_ENABLE_PROPERTY_MOCKS=true

# Enable UI development mocks for bookings when backend booking API is not yet available (TV2)
# Set to 'true' to load mock customer bookings in DEV mode only. Never active in production builds.
VITE_ENABLE_BOOKING_MOCKS=true
